name: PC28 Bot Runner

on:
  schedule:
    - cron: '*/5 * * * *' # 每 5 分鐘自動執行一次
  workflow_dispatch: # 支援手動觸發

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'
      - name: Install dependencies
        run: pip install -r requirements.txt
      - name: Run bot script
        run: python bot.py
